# Підрядки, яких при ON немає в жодному UI-рядку смерті/спавну/панелі капсули (REQ-0010-40, список §2 п.6 спеки). Порівняння — без регістру.
# «Новий виживальник» — це OFF-кнопка; при ON її заступає «З'явитись у капсулі».
const FORBIDDEN_ON := ["щоденна капсула", "новий виживальник", "до 5-го дня", "багаття", "поселення й склад", "прибуде туди"]

static func t(key: String) -> String:
	return String(TEXTS.get(key, ""))

# Сторона світу, звідки йде рейд (dir = край мапи спавну: 0 захід, 1 схід, 2 північ, 3 південь — Threats.edge_cell).
static func dir_word(dir: int) -> String:
	return t("dir_%d" % clampi(dir, 0, 3))

# Текст банера рейду з даних автомата (`sim.capsule_raid` + годинник): "" = лишити банер симу як є (не стан рейду).
static func raid_banner(state: String, r: Dictionary, now_ms: int) -> String:
	var dir: String = dir_word(int(r.get("dir", 0)))
	var n: int = int(r.get("count", 0))
	if state == "warning":
		var left: String = Fmt.left_ms(int(r.get("contact_at", 0)) - now_ms)
		return t("raid_warn") % [dir, n, left] if n > 0 else t("raid_warn_nocount") % [dir, left]
	if state == "contact":
		return t("raid_contact") % [dir, n] if n > 0 else t("raid_contact_nocount") % [dir]
	return ""
